# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and loaded automatically by eve/Next.js in local dev.

# Required: Vercel AI Gateway key so the agent can call its model.
# Create one at https://vercel.com/dashboard/ai/api-keys
AI_GATEWAY_API_KEY=

# Local web-chat auth secrets. Any random value works for local development;
# generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Only needed for the "Sign in with Vercel" flow in production builds.
# Leave the placeholders for local development.
VERCEL_APP_CLIENT_ID=local-dev-client-id
VERCEL_APP_CLIENT_SECRET=local-dev-client-secret
